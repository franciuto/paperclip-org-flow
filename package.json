{
  "name": "paperclip-plugin-org-flow",
  "version": "1.2.0",
  "type": "module",
  "private": true,
  "description": "Org Flow: Paperclip's live org chart, showing who is working on what, tasks grouped by parent and animated handoffs",
  "homepage": "https://github.com/franciuto/paperclip-org-flow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/franciuto/paperclip-org-flow.git"
  },
  "bugs": {
    "url": "https://github.com/franciuto/paperclip-org-flow/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ./esbuild.config.mjs",
    "dev": "node ./esbuild.config.mjs --watch",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test:ui": "node tests/ui/shoot.mjs"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "keywords": [
    "paperclip",
    "plugin",
    "ui"
  ],
  "author": "franciuto",
  "license": "MIT",
  "devDependencies": {
    "@paperclipai/plugin-sdk": "2026.1023.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.27.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
